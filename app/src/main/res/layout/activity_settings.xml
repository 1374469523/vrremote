<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_card"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:text="设置"
        android:textColor="@color/light_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="默认模式"
                    android:textColor="@color/light_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/defaultModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/defaultNormal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="普通模式 · 方向键遥控器" />

                    <RadioButton
                        android:id="@+id/defaultFlyTouch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="飞鼠1 · 触控板控制光标" />

                    <RadioButton
                        android:id="@+id/defaultFlyMotion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="飞鼠2 · 体感控制光标" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/dpadStepLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/light_text"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/dpadStepSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="60" />

                <TextView
                    android:id="@+id/touchGainLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/light_text"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/touchGainSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="80" />

                <TextView
                    android:id="@+id/motionGainLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/light_text"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/motionGainSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="40" />

                <TextView
                    android:id="@+id/motionDeadZoneLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/light_text"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/motionDeadZoneSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="20" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <Switch
                    android:id="@+id/hintSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="切换模式时弹出提示"
                    android:textColor="@color/light_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
